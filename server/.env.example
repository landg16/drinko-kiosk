PORT=8000
CLIENT_URL=http://localhost:5173

# Which board driver to use (see src/hardware/registry.ts):
#   mock   = the Drinko board, simulated in software (default)
#   serial = the Drinko board over USB serial
HARDWARE=mock
# COM4 on Windows, /dev/drinko or /dev/ttyUSB0 on Linux; required when HARDWARE=serial
SERIAL_PATH=
# lf or crlf, until the probe confirms the framing
SERIAL_TERMINATOR=lf
# 1 = mock pours take real time, 0 = instant
MOCK_TIME_SCALE=1

ADMIN_PIN=1234
DB_PATH=./data/drinko.sqlite
CONFIG_PATH=./config/drinko.json
CLIENT_DIST=../client/dist
LOG_LEVEL=info
